{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sophia",
  "version": "0.1.0",
  "identifier": "com.zhengjiaqiao.symsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sophia",
        "width": 1100,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhengjiaqiao/sophia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0N0E5QTRDOEE1RUMzMTcKUldRWHcxNktUSnA2eEtWaTZmVFZPV1Q4QkJVRUFmSEx4SG9nNVgrbkxWelk1OXloR3hZWjJXamwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
