{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sophia",
  "version": "0.1.1",
  "identifier": "com.zhengjiaqiao.sophia",
  "mainBinaryName": "Sophia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sophia",
        "width": 1100,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 17 },
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhengjiaqiao/sophia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCQ0YzN0VBRkNFREFBRUYKUldUdnF1Mzg2amZQKy9VRjl0eEROaG1JL2l0ODg5OGYzY252UEJBb0xhaHdjc2M2NHlhbm9ZdEoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
