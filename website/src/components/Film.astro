---
// 首屏短片：舞台（镜头）+ 播放 / 暂停键 + 6 段进度条。播放逻辑在 src/demos/film.ts，接线在 src/client/film.ts。
// 加镜头：在舞台里按序放 components/film/Shot*.astro，并在 src/client/film-shots/index.ts 追加对应的 Shot（见该文件）。
import "../styles/film.css";
import { t, type Lang } from "../i18n.ts";
import "../styles/film-shots.css";
import ShotAgents from "./film/ShotAgents.astro";
import ShotChat from "./film/ShotChat.astro";
import ShotEnd from "./film/ShotEnd.astro";
import ShotModels from "./film/ShotModels.astro";
import ShotSkills from "./film/ShotSkills.astro";
import ShotUsage from "./film/ShotUsage.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const SEGMENTS = 6;
---

<div class="film-wrap" data-film>
  <div class="film" id="film">
    <ShotAgents lang={lang} />
    <ShotSkills lang={lang} />
    <ShotModels lang={lang} />
    <ShotChat lang={lang} />
    <ShotUsage lang={lang} />
    <ShotEnd lang={lang} />
    <!-- 演示用的光标：只在有点击的镜头里出现（client/film-shots/cursor.ts），静态时不显示 -->
    <svg class="ghost" viewBox="0 0 22 22" aria-hidden="true">
      <path d="M4 2.5v15.2l4.1-3.9 2.7 6.1 2.6-1.1-2.7-6h5.8z" fill="#1c1c1a" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"></path>
    </svg>
  </div>
  <div class="film-ctl">
    <button
      class="play"
      type="button"
      data-playing="false"
      aria-label={t(lang, "film.play")}
      data-label-play={t(lang, "film.play")}
      data-label-pause={t(lang, "film.pause")}
    >
      <svg class="i-play" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M4 2.5v9l7.5-4.5z"></path></svg>
      <svg class="i-pause" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
        <rect x="3" y="2" width="3" height="10" rx="1"></rect><rect x="8" y="2" width="3" height="10" rx="1"></rect>
      </svg>
    </button>
    <div class="reel">
      {
        Array.from({ length: SEGMENTS }, (_, i) => (
          <button type="button" aria-label={t(lang, "film.shot", { n: i + 1 })}>
            <i>
              <b />
            </i>
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  import "../client/film.ts";
</script>
