---
// 整页骨架：head（语言、hreflang、标题）+ 各区块，按画板顺序。区块各自一个文件，后续的票只改自己那个
import "../styles/site.css";
import favicon from "../../../assets/logo/mark.svg";
import { SITE } from "../site.config.ts";
import { t, type Lang } from "../i18n.ts";
import { homeRedirect } from "../lib/homeRedirect.ts";
import { LANG_COOKIE } from "../lib/langs.ts";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ModelSection from "../components/ModelSection.astro";
import SkillSection from "../components/SkillSection.astro";
import UsageSection from "../components/UsageSection.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const here = SITE.langs.find((l) => l.code === lang)!;
const abs = (path: string) => `${SITE.origin}${SITE.href(path)}`;
// 首页（英文页）按选过的语言或浏览器语言跳到对应语言页：函数源码内联在 head 最前面，同步执行（见 lib/homeRedirect.ts）
const paths = Object.fromEntries(SITE.langs.map((l) => [l.code, SITE.href(l.path)]));
const redirect =
  here.path === "/" ? `(${homeRedirect})(${[lang, paths, LANG_COOKIE].map((v) => JSON.stringify(v)).join(", ")}, window);` : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {redirect && <script is:inline set:html={redirect} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{t(lang, "meta.title")}</title>
    <meta name="description" content={t(lang, "meta.description")} />
    <link rel="canonical" href={abs(here.path)} />
    {SITE.langs.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(l.path)} />)}
    <link rel="alternate" hreflang="x-default" href={abs("/")} />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
  </head>
  <body>
    <div class="site" id="top">
      <Header lang={lang} />
      <main>
        <Hero lang={lang} />
        <ModelSection lang={lang} />
        <SkillSection lang={lang} />
        <UsageSection lang={lang} />
        <Install lang={lang} />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
